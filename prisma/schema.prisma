// 餐廳員工打卡系統 — Prisma schema
//
// 已從特休/薪資/公告系統獨立，只保留：
//   - 員工帳號 (User + AvatarConfig)
//   - 餐廳地點 (Restaurant)
//   - 打卡紀錄 (Attendance)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// 員工
// ─────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  employeeNo   String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  jobTitle     String?              // 廚師、外場、吧台、店長…
  hireDate     DateTime @default(now())
  active       Boolean  @default(true)

  attendances  Attendance[]
  avatarConfig AvatarConfig?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  EMPLOYEE
  MANAGER   // 店長
  ADMIN
}

// ─────────────────────────────────────────────────────────────
// 員工角色外觀（楓之谷風 — 接 maplestory.io）
// 每個欄位都是 maplestory.io 的 item ID
// ─────────────────────────────────────────────────────────────
model AvatarConfig {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 必選 — 角色身體 / 頭 / 臉 / 髮
  bodyId        Int     @default(2000)
  headId        Int     @default(12000)
  faceId        Int     @default(20000)
  hairId        Int     @default(30030)

  // 裝備 (null = 無)
  hatId             Int?
  topId             Int?
  bottomId          Int?
  overallId         Int?    // 連身衣 (與 top/bottom 互斥)
  shoesId           Int?
  capeId            Int?
  glovesId          Int?
  weaponId          Int?
  faceAccessoryId   Int?
  eyeAccessoryId    Int?
  earringsId        Int?

  // maplestory.io 版本號
  version       String  @default("222")

  statusMessage String? @db.VarChar(60)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 餐廳分店
// 一個帳號可以服務多間分店；員工只能在分店允許範圍內打卡
// ─────────────────────────────────────────────────────────────
model Restaurant {
  id           String  @id @default(cuid())
  name         String                       // 例：忠孝店、信義店
  address      String?
  latitude     Float?                       // GPS 中心
  longitude    Float?
  radiusMeters Int     @default(200)        // 允許打卡半徑
  ipWhitelist  String?                      // IP 白名單 CSV
  timezone     String  @default("Asia/Taipei")
  active       Boolean @default(true)

  attendances  Attendance[]

  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 打卡紀錄
// ─────────────────────────────────────────────────────────────
model Attendance {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          PunchType
  punchedAt     DateTime                              // 一律 server time

  restaurantId  String?
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id])

  latitude      Float?
  longitude     Float?
  ipAddress     String?
  userAgent     String?    @db.Text
  locationValid Boolean    @default(true)

  note          String?

  createdAt     DateTime   @default(now())

  @@index([userId, punchedAt])
  @@index([punchedAt])
}

enum PunchType {
  CLOCK_IN     // 上班
  CLOCK_OUT    // 下班
  BREAK_OUT    // 休息（外出）
  BREAK_IN     // 結束休息
}
